{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/project/[id]",
      "regex": "^/project/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/project/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/auth",
      "regex": "^/auth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/cities",
      "regex": "^/dashboard/cities(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/cities(?:/)?$"
    },
    {
      "page": "/dashboard/create-project",
      "regex": "^/dashboard/create\\-project(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/create\\-project(?:/)?$"
    },
    {
      "page": "/dashboard/developers",
      "regex": "^/dashboard/developers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/developers(?:/)?$"
    },
    {
      "page": "/dashboard/projects",
      "regex": "^/dashboard/projects(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/projects(?:/)?$"
    },
    {
      "page": "/dashboard/users",
      "regex": "^/dashboard/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/users(?:/)?$"
    },
    {
      "page": "/developers",
      "regex": "^/developers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/developers(?:/)?$"
    },
    {
      "page": "/developers/add",
      "regex": "^/developers/add(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/developers/add(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/listings",
      "regex": "^/listings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/listings(?:/)?$"
    },
    {
      "page": "/my-activity",
      "regex": "^/my\\-activity(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/my\\-activity(?:/)?$"
    },
    {
      "page": "/my-activity/enquiries",
      "regex": "^/my\\-activity/enquiries(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/my\\-activity/enquiries(?:/)?$"
    },
    {
      "page": "/my-activity/saved",
      "regex": "^/my\\-activity/saved(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/my\\-activity/saved(?:/)?$"
    },
    {
      "page": "/my-activity/seen",
      "regex": "^/my\\-activity/seen(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/my\\-activity/seen(?:/)?$"
    },
    {
      "page": "/profile",
      "regex": "^/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/profile(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": []
}